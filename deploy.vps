#!/usr/bin/env bash
# ==============================================================================
# AloneKing Star Bypass Bot — One-Script VPS Deployment (deploy.vps)
# ==============================================================================
# Usage:
#   bash deploy.vps                  # Interactive setup (uses exported env vars if set)
#   bash deploy.vps --non-interactive # Zero-prompt deploy using exported shell vars
# ==============================================================================
set -Eeuo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log_info()  { echo -e "${CYAN}[INFO]${NC} $*"; }
log_ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_err()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

NON_INTERACTIVE=false
for arg in "$@"; do
  case "$arg" in
    --non-interactive|-y) NON_INTERACTIVE=true ;;
  esac
done

echo -e "${BOLD}${CYAN}"
echo "=========================================================="
echo "      ★ ALONEKING STAR BYPASS BOT — VPS DEPLOYER ★        "
echo "=========================================================="
echo -e "${NC}"

# 1. Privilege helper
if [ "${EUID:-$(id -u)}" -eq 0 ]; then
  SUDO=""
else
  if command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
  else
    log_err "Please run as root or install sudo."
    exit 1
  fi
fi

# 2. Resolve application directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$SCRIPT_DIR"
if [ ! -f "$APP_DIR/requirements.txt" ] || [ ! -d "$APP_DIR/FZBypass" ]; then
  log_err "Run deploy.vps from inside the AloneKing Star Bypass Bot repository directory."
  exit 1
fi
cd "$APP_DIR"
log_ok "Project directory: $APP_DIR"

# 3. Install system dependencies (Ubuntu / Debian)
if command -v apt-get >/dev/null 2>&1; then
  log_info "Installing system packages via apt..."
  $SUDO apt-get update -qq
  $SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    python3 python3-venv python3-pip python3-dev \
    git curl ca-certificates build-essential \
    libxml2-dev libxslt1-dev zlib1g-dev >/dev/null
  log_ok "System packages installed."
else
  log_warn "apt-get not detected; ensuring python3 and pip are present..."
  command -v python3 >/dev/null 2>&1 || { log_err "python3 is required."; exit 1; }
fi

# 4. Create isolated Python virtual environment & install dependencies
VENV_DIR="$APP_DIR/.venv"
if [ ! -d "$VENV_DIR" ]; then
  log_info "Creating Python virtual environment at $VENV_DIR..."
  python3 -m venv "$VENV_DIR"
fi

log_info "Upgrading pip & installing Python dependencies..."
"$VENV_DIR/bin/python3" -m pip install --upgrade --quiet pip wheel setuptools
"$VENV_DIR/bin/pip" install --no-cache-dir --quiet -r "$APP_DIR/requirements.txt"
log_ok "All Python dependencies installed cleanly."

# 5. Credential collection (Shell exports take priority; prompt only if missing)
prompt_var() {
  local var_name="$1"
  local prompt_label="$2"
  local default_val="${3:-}"
  local required="${4:-false}"
  local current_val="${!var_name:-}"

  if [ -n "$current_val" ]; then
    log_ok "Using exported shell variable: $var_name"
    return 0
  fi

  if [ "$NON_INTERACTIVE" = true ]; then
    if [ "$required" = true ] && [ -z "$default_val" ]; then
      log_err "Missing required exported variable: $var_name (non-interactive mode)"
      exit 1
    fi
    printf -v "$var_name" '%s' "$default_val"
    return 0
  fi

  while true; do
    if [ -n "$default_val" ]; then
      read -r -p "  $prompt_label [$default_val]: " input_val
      input_val="${input_val:-$default_val}"
    else
      read -r -p "  $prompt_label: " input_val
    fi
    if [ "$required" = true ] && [ -z "$input_val" ]; then
      log_warn "$var_name is required. Please enter a value."
      continue
    fi
    printf -v "$var_name" '%s' "$input_val"
    break
  done
}

echo ""
log_info "Configuring credentials (exported shell variables are preserved automatically)..."
prompt_var BOT_TOKEN             "Telegram BOT_TOKEN"                   ""      true
prompt_var API_ID                "Telegram API_ID"                      ""      true
prompt_var API_HASH              "Telegram API_HASH"                    ""      true
prompt_var OWNER_ID              "Telegram OWNER_ID (numeric)"          ""      true
prompt_var AUTH_CHATS            "AUTH_CHATS (space-separated IDs)"     ""      false
prompt_var AUTO_BYPASS           "AUTO_BYPASS (True/False)"             "False" false
prompt_var CMD_SUFFIX            "CMD_SUFFIX (optional)"                ""      false
prompt_var DIRECT_INDEX          "DIRECT_INDEX URL (optional)"          ""      false
prompt_var TERA_COOKIE           "TERA_COOKIE ndus (optional)"          ""      false
prompt_var GDTOT_CRYPT           "GDTOT_CRYPT (optional)"               ""      false
prompt_var HUBDRIVE_CRYPT        "HUBDRIVE_CRYPT (optional)"            ""      false
prompt_var KATDRIVE_CRYPT        "KATDRIVE_CRYPT (optional)"            ""      false
prompt_var DRIVEFIRE_CRYPT       "DRIVEFIRE_CRYPT (optional)"           ""      false
prompt_var LARAVEL_SESSION       "LARAVEL_SESSION (optional)"           ""      false
prompt_var XSRF_TOKEN            "XSRF_TOKEN (optional)"                ""      false
prompt_var PORT                  "Health Server PORT"                   "8080"  false
prompt_var WORKERS               "Async Workers"                        "16"    false
prompt_var BYPASS_TIMEOUT        "Bypass HTTP Timeout (sec)"            "25"    false
prompt_var MAX_CONCURRENT_BYPASS "Max Concurrent Bypasses"              "25"    false
prompt_var MAX_LOOP_HOPS         "Max Nested Shortener Hops"            "10"    false
prompt_var AUTO_UPDATE           "AUTO_UPDATE on restart (True/False)"  "False" false
prompt_var UPSTREAM_REPO         "UPSTREAM_REPO URL (optional)"         ""      false
prompt_var UPSTREAM_BRANCH       "UPSTREAM_BRANCH"                      "main"  false

# 6. Write shell-exportable env.sh (chmod 600) and source it
ENV_FILE="$APP_DIR/env.sh"
cat > "$ENV_FILE" <<EOF
# AloneKing Star Bypass Bot — Generated Shell Exports
export BOT_TOKEN="$(printf '%s' "$BOT_TOKEN" | sed 's/"/\\"/g')"
export API_ID="$(printf '%s' "$API_ID" | sed 's/"/\\"/g')"
export API_HASH="$(printf '%s' "$API_HASH" | sed 's/"/\\"/g')"
export OWNER_ID="$(printf '%s' "$OWNER_ID" | sed 's/"/\\"/g')"
export AUTH_CHATS="$(printf '%s' "$AUTH_CHATS" | sed 's/"/\\"/g')"
export AUTO_BYPASS="$(printf '%s' "$AUTO_BYPASS" | sed 's/"/\\"/g')"
export CMD_SUFFIX="$(printf '%s' "$CMD_SUFFIX" | sed 's/"/\\"/g')"
export DIRECT_INDEX="$(printf '%s' "$DIRECT_INDEX" | sed 's/"/\\"/g')"
export TERA_COOKIE="$(printf '%s' "$TERA_COOKIE" | sed 's/"/\\"/g')"
export GDTOT_CRYPT="$(printf '%s' "$GDTOT_CRYPT" | sed 's/"/\\"/g')"
export HUBDRIVE_CRYPT="$(printf '%s' "$HUBDRIVE_CRYPT" | sed 's/"/\\"/g')"
export KATDRIVE_CRYPT="$(printf '%s' "$KATDRIVE_CRYPT" | sed 's/"/\\"/g')"
export DRIVEFIRE_CRYPT="$(printf '%s' "$DRIVEFIRE_CRYPT" | sed 's/"/\\"/g')"
export LARAVEL_SESSION="$(printf '%s' "$LARAVEL_SESSION" | sed 's/"/\\"/g')"
export XSRF_TOKEN="$(printf '%s' "$XSRF_TOKEN" | sed 's/"/\\"/g')"
export PORT="$(printf '%s' "$PORT" | sed 's/"/\\"/g')"
export WORKERS="$(printf '%s' "$WORKERS" | sed 's/"/\\"/g')"
export BYPASS_TIMEOUT="$(printf '%s' "$BYPASS_TIMEOUT" | sed 's/"/\\"/g')"
export MAX_CONCURRENT_BYPASS="$(printf '%s' "$MAX_CONCURRENT_BYPASS" | sed 's/"/\\"/g')"
export MAX_LOOP_HOPS="$(printf '%s' "$MAX_LOOP_HOPS" | sed 's/"/\\"/g')"
export AUTO_UPDATE="$(printf '%s' "$AUTO_UPDATE" | sed 's/"/\\"/g')"
export UPSTREAM_REPO="$(printf '%s' "$UPSTREAM_REPO" | sed 's/"/\\"/g')"
export UPSTREAM_BRANCH="$(printf '%s' "$UPSTREAM_BRANCH" | sed 's/"/\\"/g')"
EOF
chmod 600 "$ENV_FILE"
# shellcheck disable=SC1090
source "$ENV_FILE"
log_ok "Saved shell exports to $ENV_FILE (permissions 600)."

# 7. Quick Python syntax & import verification
log_info "Verifying bot package syntax..."
"$VENV_DIR/bin/python3" -m compileall -q "$APP_DIR/FZBypass"
log_ok "Syntax check passed."

# 8. Install and start systemd service
SERVICE_NAME="aloneking-bypass"
SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}.service"
RUN_USER="${SUDO_USER:-$(whoami)}"

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  log_info "Configuring systemd service ($SERVICE_NAME)..."
  $SUDO tee "$SERVICE_FILE" >/dev/null <<EOF
[Unit]
Description=AloneKing Star Bypass Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${RUN_USER}
WorkingDirectory=${APP_DIR}
ExecStart=/bin/bash -c 'source "${ENV_FILE}" && exec "${VENV_DIR}/bin/python3" -m FZBypass'
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

  $SUDO systemctl daemon-reload
  $SUDO systemctl enable "$SERVICE_NAME" >/dev/null
  $SUDO systemctl restart "$SERVICE_NAME"
  sleep 2

  if $SUDO systemctl is-active --quiet "$SERVICE_NAME"; then
    log_ok "Service '$SERVICE_NAME' is RUNNING!"
  else
    log_err "Service failed to start. Recent logs:"
    $SUDO journalctl -u "$SERVICE_NAME" -n 30 --no-pager || true
    exit 1
  fi
else
  log_warn "systemd not active in this environment. Starting bot in background via nohup..."
  nohup /bin/bash -c "source '${ENV_FILE}' && exec '${VENV_DIR}/bin/python3' -m FZBypass" > "$APP_DIR/bot.out" 2>&1 &
  log_ok "Bot started in background (PID: $!). Logs: $APP_DIR/bot.out"
fi

echo ""
echo -e "${GREEN}${BOLD}==========================================================${NC}"
echo -e "${GREEN}${BOLD}   ★ AloneKing Star Bypass Bot Deployed Successfully! ★   ${NC}"
echo -e "${GREEN}${BOLD}==========================================================${NC}"
echo -e "  • Credentials file : ${BOLD}${ENV_FILE}${NC} (source anytime with: ${CYAN}source env.sh${NC})"
echo -e "  • Health endpoint  : ${CYAN}http://localhost:${PORT}${NC}"
echo -e "  • Live logs        : ${CYAN}sudo journalctl -u ${SERVICE_NAME} -f${NC}"
echo -e "  • Restart bot      : ${CYAN}sudo systemctl restart ${SERVICE_NAME}${NC}"
echo -e "  • Stop bot         : ${CYAN}sudo systemctl stop ${SERVICE_NAME}${NC}"
echo ""
